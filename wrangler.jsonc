{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-08-20",
  "observability": {
    "enabled": true
  }
  // `main`, `assets` and `compatibility_flags` are intentionally absent: the
  // Nitro cloudflare_module preset merges this file into
  // .output/server/wrangler.json at build time and wrangler is redirected
  // there via .wrangler/deploy/config.json. Setting them here only produced
  // "overridden and will be ignored" warnings. Build before deploying.
}
